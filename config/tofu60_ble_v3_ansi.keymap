#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "boards/shields/klink_kbd/common.keymap"

#define UF_RESET bootloader_reset 0 0
#define UF_BT1 device_bt1 0 0
#define UF_BT2 device_bt2 0 1
#define UF_BT3 device_bt3 0 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&gresc            &kp N1        &kp N2    &kp N3     &kp N4         &kp N5             &kp N6             &kp N7             &kp N8     &kp N9      &kp N0         &kp MINUS         &kp EQUAL          &kp BSLH
&kp TAB           &kp Q         &kp W     &kp E      &kp R          &kp T              &kp Y              &kp U              &kp I      &kp O       &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&lt 1 CAPSLOCK    &kp A         &kp S     &kp D      &kp F          &kp G              &kp H              &kp J              &kp K      &kp L       &kp SEMICOLON  &kp SQT           &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X     &kp C      &kp V          &kp B              &kp M              &kp N              &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHFT
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LALT  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_COMMAND  &lt 2 PRINTSCREEN  &kp RIGHT_CONTROL
            >;
        };

        layer1 {
            bindings = <
&trans      &kp F1      &kp F2           &kp F3  &kp F4  &kp F5      &kp F6            &kp F7          &kp F8            &kp F9         &kp F10  &kp F11  &kp F12          &trans
&kp DELETE  &trans      &trans           &none   &trans  &trans      &kp LA(LEFT)      &kp LA(DOWN)    &kp LA(UP_ARROW)  &kp LA(RIGHT)  &none    &none    &kp PRINTSCREEN  &kp SCROLLLOCK
&none       &trans      &none            &none   &none   &trans      &kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT      &none    &none    &none
&trans      &bl BL_TOG  &rgb_ug RGB_TOG  &trans  &trans  &none       &kp LG(LEFT)      &kp LG(DOWN)    &kp LG(UP_ARROW)  &kp LG(RIGHT)  &none    &none
&none       &trans      &trans           &trans  &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
            >;
        };

        layer2 { status = "reserved"; };

        layer3 { status = "reserved"; };

        layer4 { status = "reserved"; };

        layer5 { status = "reserved"; };

        layer6 { status = "reserved"; };

        layer7 { status = "reserved"; };
    };
};
